diff --git a/artifacts/crossnotes/src/crossnotes.css b/artifacts/crossnotes/src/crossnotes.css
index 418d612..d14a4d1 100644
--- a/artifacts/crossnotes/src/crossnotes.css
+++ b/artifacts/crossnotes/src/crossnotes.css
@@ -345,7 +345,113 @@ html, body {
   transform: translateY(-2px);
   box-shadow: 0 5px 0 var(--primary-shadow), 0 8px 20px rgba(139, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.2);
 }
-.avatar-initial { color: var(--primary); font-weight: 800; font-size: 15px; }
+.avatar-initial { color: #fff; font-weight: 800; font-size: 15px; }
+
+/* ─── ACCOUNT MENU — profile shortcuts in a raised clay popover ─── */
+.account-menu-wrap { position: relative; }
+.account-menu {
+  position: absolute;
+  top: calc(100% + 11px);
+  right: -2px;
+  z-index: 80;
+  width: min(300px, calc(100vw - 28px));
+  padding: 10px;
+  border-radius: 24px;
+  background: color-mix(in srgb, var(--bg-card) 94%, white);
+  box-shadow: 10px 12px 25px rgba(64, 46, 122, 0.16), -5px -5px 16px rgba(255, 255, 255, 0.82), inset 0 1px 0 rgba(255, 255, 255, 0.9);
+  animation: account-menu-rise 0.18s cubic-bezier(0.34, 1.56, 0.64, 1) both;
+}
+.dark-mode .account-menu {
+  background: color-mix(in srgb, var(--bg-card) 94%, #151026);
+  box-shadow: 10px 12px 25px rgba(0, 0, 0, 0.4), -3px -3px 10px rgba(255, 255, 255, 0.035), inset 0 1px 0 rgba(255, 255, 255, 0.05);
+}
+.account-menu-profile {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 9px 13px;
+  color: var(--text);
+}
+.account-menu-profile-icon,
+.account-setting-icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: 0 0 auto;
+  border-radius: 12px;
+}
+.account-menu-profile-icon {
+  width: 32px;
+  height: 32px;
+  background: var(--violet-bg);
+  color: var(--violet-shadow);
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72), 0 2px 0 color-mix(in srgb, var(--violet-shadow) 20%, transparent);
+}
+.account-menu-profile > span:last-child { min-width: 0; display: grid; gap: 2px; }
+.account-menu-profile strong,
+.account-menu-profile small,
+.account-setting-toggle strong,
+.account-setting-toggle small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.account-menu-profile strong { font-size: 13px; font-weight: 850; }
+.account-menu-profile small { color: var(--text-muted); font-size: 11px; font-weight: 650; }
+.account-menu-item {
+  width: 100%;
+  min-height: 43px;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 0 11px;
+  border: 0;
+  border-radius: 15px;
+  background: transparent;
+  color: var(--text);
+  font-family: var(--font-body);
+  font-size: 13px;
+  font-weight: 800;
+  text-decoration: none;
+  text-align: left;
+  cursor: pointer;
+  transition: transform 0.15s, background 0.15s, color 0.15s;
+}
+.account-menu-item:hover { background: var(--bg-card-2); transform: translateX(-2px); }
+.account-menu-item:focus-visible,
+.account-setting-toggle:focus-visible { outline: 3px solid color-mix(in srgb, var(--primary) 35%, transparent); outline-offset: 2px; }
+.account-menu-settings .account-menu-chevron { margin-left: auto; transition: transform 0.18s ease; }
+.account-menu-settings.expanded .account-menu-chevron { transform: rotate(180deg); }
+.account-settings-panel {
+  display: grid;
+  gap: 6px;
+  margin: 2px 0 7px;
+  padding: 8px;
+  border-radius: 17px;
+  background: var(--bg-card-2);
+  box-shadow: inset 2px 2px 5px rgba(83, 61, 150, 0.08), inset -2px -2px 5px rgba(255, 255, 255, 0.72);
+}
+.account-setting-toggle {
+  min-width: 0;
+  display: grid;
+  grid-template-columns: 30px minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 8px;
+  padding: 7px;
+  border: 0;
+  border-radius: 12px;
+  background: transparent;
+  color: var(--text);
+  font-family: var(--font-body);
+  text-align: left;
+  cursor: pointer;
+}
+.account-setting-toggle:hover { background: var(--bg-card); }
+.account-setting-icon { width: 30px; height: 30px; background: var(--bg-card); color: var(--primary); box-shadow: var(--shadow-ghost); }
+.account-setting-toggle > span:nth-child(2) { min-width: 0; display: grid; gap: 1px; }
+.account-setting-toggle strong { font-size: 11px; font-weight: 850; }
+.account-setting-toggle small { color: var(--text-muted); font-size: 10px; font-weight: 650; }
+.account-setting-toggle em { padding: 4px 6px; border-radius: var(--r-pill); background: var(--violet-bg); color: var(--violet-shadow); font-size: 10px; font-style: normal; font-weight: 850; }
+.account-menu-divider { height: 1px; margin: 6px 4px; background: color-mix(in srgb, var(--text-muted) 18%, transparent); }
+.account-menu-logout { color: var(--red); }
+.account-menu-logout:hover { background: var(--red-light); }
+@keyframes account-menu-rise { from { opacity: 0; transform: translateY(-7px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
 
 /* ─── BOTTOM NAV — floating clay pill ────────────────────────────── */
 .bottom-nav {
@@ -1406,6 +1512,7 @@ a:hover .tilt-left, a:hover .tilt-right { transform: rotate(0deg) translateY(-3p
 @keyframes feedback-rise { from { opacity: 0; transform: translateY(15px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
