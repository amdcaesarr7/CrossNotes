# Configure these as Firebase Functions secrets; never place them in the React/Vite app.
#
# Instagram requirements:
# 1. @crossnotes.fr must be a professional account linked to a Meta developer app.
# 2. The intended recipient must message @crossnotes.fr first.
# 3. Capture the recipient's Instagram-scoped ID (IGSID) from the messaging webhook.
# 4. Use an access token with instagram_business_manage_messages.
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_RECIPIENT_IGSID=

# Email fallback requirements:
# Use a verified sender domain/account with Resend.
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=caesar.anwarr91@gmail.com
NOTIFICATION_EMAIL_FROM=CrossNotes Support <support@your-verified-domain.example>
