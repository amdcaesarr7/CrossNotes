   .feedback-modal { padding: 28px 19px 21px; border-radius: 30px; }
   .feedback-kind-grid { grid-template-columns: 1fr; gap: 8px; margin-top: 20px; }
   .feedback-kind { min-height: 0; flex-direction: row; align-items: center; gap: 11px; padding: 11px; }
@@ -1414,8 +1521,8 @@ a:hover .tilt-left, a:hover .tilt-right { transform: rotate(0deg) translateY(-3p
   .feedback-privacy { max-width: 132px; }
 }
 @media (prefers-reduced-motion: reduce) {
-  .feedback-overlay, .feedback-modal { animation: none; }
-  .feedback-launcher, .feedback-kind, .feedback-close { transition: none; }
+  .feedback-overlay, .feedback-modal, .account-menu { animation: none; }
+  .feedback-launcher, .feedback-kind, .feedback-close, .account-menu-item, .account-menu-chevron { transition: none; }
 }
 
